<%- include("../common/header.ejs") %>
    <%- include("../common/sidebar.ejs") %>
        <div class="main-content">
            <div class="page-content">
                <div class="container-fluid">
                    <div class="title-box mb-3 pb-1">
                        <h4 class="mb-0 page-title">Category Listing</h4>
                        <nav aria-label="breadcrumb" class="mt-1">
                            <ol class="breadcrumb mb-0">
                                <li class="breadcrumb-item"><a href="/dashboard"><i class="ri-home-4-fill me-1"></i>
                                        Dashboard</a></li>
                                <li class="breadcrumb-item active" aria-current="page">Category Listing</li>
                            </ol>
                        </nav>
                    </div>

                    <div class="card">
                        <div class="card-body cusbar">
                            <div class="card-head justify-content-between adjusttwo mb-3" style="flex-wrap: wrap;">
                                <div class="d-flex">
                                    <div class="tbl-search position-relative">
                                        <input type="" name="" class="form-control" placeholder="Search...">
                                        <i class="ri-search-line"></i>
                                    </div>

                                </div>
                                <div class="adnmem">
                                    <button class="btn btn-primary" data-bs-toggle="offcanvas"
                                        data-bs-target="#add-user" aria-controls="offcanvasRight"><i
                                            class="ri-add-line me-1"></i>Add Category</button>
                                </div>
                            </div>
                            <div class="table-responsive table-card border-top hltr">
                                <div data-simplebar style="height: 532px" class="cus-scroll scmob">
                                    <table class="table table-centered cus-nowrap align-middle mb-0">
                                        <thead>
                                            <tr>
                                                <th>Name </th>
                                                <th>Image</th>
                                                <th>Status</th>
                                                <th>Action</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <tr>
                                                <td>
                                                    <a>
                                                        <div>Alice Johnson</div>
                                                    </a>
                                                </td>
                                                <td>
                                                    <img src="assets/images/users/avatar-1.jpg" alt="avatar"
                                                        class="rounded-circle" height="35" width="35">
                                                </td>

                                                <td>
                                                    <div>
                                                        Offline
                                                    </div>
                                                </td>

                                                <td class="text-center">
                                                    <div class="d-flex justify-content-center">
                                                        <button type="button"
                                                            class="btn btn-soft-primary px-2 btn-sm me-1"
                                                            data-bs-toggle="offcanvas" data-bs-target="#view-details"
                                                            aria-controls="offcanvasRight">
                                                            <i class="ri-eye-fill font-size-16"></i>
                                                        </button>
                                                        <button type="button"
                                                            class="btn bg-soft-warning px-2 btn-sm me-1"
                                                            data-bs-toggle="offcanvas" data-bs-target="#tbl-edit"
                                                            aria-controls="offcanvasRight">
                                                            <i class="ri-edit-line font-size-16"></i>
                                                        </button>
                                                        <button type="button" class="btn btn-soft-danger px-2 btn-sm"
                                                            data-bs-toggle="modal" data-bs-target="#removeModal">
                                                            <i class="ri-delete-bin-line font-size-16"></i>
                                                        </button>
                                                    </div>
                                                </td>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                            <!-- end table-responsive -->
                            <div class="d-flex justify-content-center">
                                <nav aria-label="...">
                                    <ul class="pagination mb-0 mt-3">
                                        <li class="page-item"><a href="javascript: void(0);" class="page-link"><i
                                                    class="ri-arrow-left-s-line"></i></a></li>
                                        <li class="page-item active">
                                            <a class="page-link" href="#" aria-current="page">1</a>
                                        </li>
                                        <li class="page-item"><a class="page-link" href="#">2</a></li>

                                        <li class="page-item"><a class="page-link" href="#"><i
                                                    class="ri-arrow-right-s-line"></i></a></li>
                                    </ul>
                                </nav>
                            </div>
                            <div class="position-relative">
                                <div class="tt-list">Showing 1 - <span class="for-small">10</span><span
                                        class="for-big">50</span> of 57</div>
                            </div>

                        </div>
                    </div>
                </div>
            </div>
        </div>
        <!-- end main content-->
        </div>



        <!-- Remove Feed Modal -->
        <div class="modal fade" id="removeModal" tabindex="-1" aria-labelledby="removeModalLabel" aria-hidden="true">
            <div class="modal-dialog modal-sm modal-dialog-centered">
                <div class="modal-content">
                    <div class="modal-body text-center dlnotr">
                        <svg width="56" height="56" viewBox="0 0 56 56" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <path
                                d="M5.6 16.8H50.4V53.2C50.4 53.9426 50.105 54.6548 49.5799 55.1799C49.0548 55.705 48.3426 56 47.6 56H8.4C7.65739 56 6.9452 55.705 6.4201 55.1799C5.895 54.6548 5.6 53.9426 5.6 53.2V16.8ZM11.2 22.4V50.4H44.8V22.4H11.2ZM19.6 28H25.2V44.8H19.6V28ZM30.8 28H36.4V44.8H30.8V28ZM14 8.4V2.8C14 2.05739 14.295 1.3452 14.8201 0.820101C15.3452 0.294999 16.0574 0 16.8 0H39.2C39.9426 0 40.6548 0.294999 41.1799 0.820101C41.705 1.3452 42 2.05739 42 2.8V8.4H56V14H0V8.4H14ZM19.6 5.6V8.4H36.4V5.6H19.6Z"
                                fill="#FF3C3C" />
                        </svg>
                        <h5 class="mt-3 manspace">Delete Account?</h5>
                        <p class="text-muted">Are you sure you want to permanently delete team member account?</p>
                        <div class="d-flex justify-content-center">
                            <button type="button" class="btn btn-primary py-2 me-2" style="min-width: 100px"
                                data-bs-dismiss="modal">Cancel</button>
                            <button type="button" class="btn btn-danger py-2" style="min-width: 100px"
                                data-bs-dismiss="modal">Yes</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>



        <!-- Add Category -->
        <div class="offcanvas offcanvas-end" tabindex="-1" id="add-user" aria-labelledby="offcanvasRightLabel">
            <div class="offcanvas-header d-block">
                <div class="d-flex align-items-center">
                    <div class="d-flex align-items-center">
                        <h5 class="offcanvas-title mb-0 me-3 fw-medium" id="offcanvasRightLabel">Add New Category
                        </h5>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
                </div>
            </div>
            <div class="offcanvas-body">
                <div class="d-flex">
                    <div class="position-relative me-3">
                        <div class="rtuimage">
                            <img src="assets/images/users/avatar-2.jpg">
                            <a href="#" class="text-primay"><i class="ri-add-circle-fill"></i></a>
                        </div>
                    </div>
                    <div>
                        <div class="font-size-17 fw-medium">Upload Image</div>
                        <div class="d-flex">
                            <button class="btn btn-outline-primary me-2">Remove</button>
                            <button class="btn btn-primary">Upload</button>
                        </div>
                    </div>
                </div>

                <div class="mb-3">
                    <label class="fw-medium mb-1">Name</label>
                    <input type="" name="" class="form-control" placeholder="Enter Name">
                </div>
                <div class="mb-3">
                    <label class="fw-medium mb-1">Description</label>
                    <input type="" name="" class="form-control" placeholder="Enter Description">
                </div>

                <div class="text-end">
                    <button class="btn btn-outline-primary px-4 me-2">Cancel</button>
                    <button class="btn btn-primary px-4">Add</button>
                </div>
            </div>
        </div>




        <!-- Edit Category -->
        <div class="offcanvas offcanvas-end" tabindex="-1" id="tbl-edit" aria-labelledby="offcanvasRightLabel">
            <div class="offcanvas-header d-block">
                <div class="d-flex align-items-center">
                    <div class="d-flex align-items-center">
                        <h5 class="offcanvas-title mb-0 me-3 fw-medium" id="offcanvasRightLabel">Edit Category</h5>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
                </div>
            </div>
            <div class="offcanvas-body">
                <div class="tab-content" id="nav-tabContent">
                    <div class="tab-pane fade show active" id="nav-profile" role="tabpanel"
                        aria-labelledby="nav-home-tab" tabindex="0">
                        <div class="d-flex mt-4">
                            <div class="position-relative me-3">
                                <div class="rtuimage">
                                    <img src="assets/images/users/avatar-2.jpg">
                                    <a href="#" class="text-primay"><i class="ri-add-circle-fill"></i></a>
                                </div>
                            </div>
                            <div>
                                <div class="font-size-17 fw-medium">Upload Image</div>
                                <div class="d-flex">
                                    <button class="btn btn-outline-primary me-2">Remove</button>
                                    <button class="btn btn-primary">Upload</button>
                                </div>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="fw-medium mb-1">Name</label>
                            <input type="" name="" class="form-control" value="">
                        </div>
                        <div class="mb-3">
                            <label class="fw-medium mb-1">Description</label>
                            <input type="" name="" class="form-control" value="">
                        </div>

                        <div class="text-end">
                            <button class="btn btn-outline-primary px-4 me-2">Cancel</button>
                            <button class="btn btn-primary px-4">Update</button>
                        </div>
                    </div>
                </div>

            </div>
        </div>


        <%- include("../common/footer.ejs") %>