<%- include("../common/header.ejs") %>
    <%- include("../common/sidebar.ejs") %>

        <div class="main-content">
            <div class="page-content">
                <div class="container-fluid">
                    <div class="title-box mb-3 pb-1">
                        <h4 class="mb-0 page-title">Faq Listing</h4>
                        <nav aria-label="breadcrumb" class="mt-1">
                            <ol class="breadcrumb mb-0">
                                <li class="breadcrumb-item"><a href="/dashboard"><i
                                            class="ri-home-4-fill me-1"></i>Dashboard</a></li>
                                <li class="breadcrumb-item active" aria-current="page">Faq Listing</li>
                            </ol>
                        </nav>
                    </div>

                    <div class="card">
                        <div class="card-body cusbar">
                            <div class="card-head justify-content-between adjusttwo mb-3" style="flex-wrap: wrap;">
                                <div class="d-flex">
                                    <div class="tbl-search position-relative">
                                        <input type="text" id="searchFaq" class="form-control" placeholder="Search...">
                                        <i class="ri-search-line"></i>
                                    </div>
                                </div>
                                <div class="adnmem">
                                    <button class="btn btn-primary" data-bs-toggle="offcanvas"
                                        data-bs-target="#add-user" aria-controls="offcanvasRight">
                                        <i class="ri-add-line me-1"></i>Add Faq
                                    </button>
                                </div>
                            </div>

                            <div class="table-responsive table-card border-top hltr">
                                <div data-simplebar style="height: 532px" class="cus-scroll scmob">
                                    <table class="table table-centered cus-nowrap align-middle mb-0">
                                        <thead>
                                            <tr>
                                                <th>Sr No</th>
                                                <th>Question</th>
                                                <th>Answer</th>
                                                <th>Action</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <% if (faqss && faqss.length> 0) { %>
                                                <% faqss.forEach((faq, index)=> { %>
                                                    <tr data-id="<%= faq.id %>">
                                                        <td>
                                                            <%= index + 1 %>
                                                        </td>
                                                        <td>
                                                            <%= faq.question %>
                                                        </td>
                                                        <td>
                                                            <%= faq.answer %>
                                                        </td>
                                                        <td class="text-center">
                                                            <div>
                                                                <button type="button"
                                                                    class="btn btn-soft-primary px-2 btn-sm me-1 viewBtn"
                                                                    data-bs-toggle="offcanvas"
                                                                    data-bs-target="#view-details"
                                                                    data-id="<%= faq.id %>">
                                                                    <i class="ri-eye-fill font-size-16"></i>
                                                                </button>

                                                                <button type="button"
                                                                    class="btn bg-soft-warning px-2 btn-sm me-1 editBtn"
                                                                    data-bs-toggle="offcanvas"
                                                                    data-bs-target="#tbl-edit" data-id="<%= faq.id %>">
                                                                    <i class="ri-edit-line font-size-16"></i>
                                                                </button>

                                                                <button type="button"
                                                                    class="btn btn-soft-danger px-2 btn-sm deleteBtn"
                                                                    data-bs-toggle="modal" data-bs-target="#removeModal"
                                                                    data-id="<%= faq.id %>">
                                                                    <i class="ri-delete-bin-line font-size-16"></i>
                                                                </button>
                                                            </div>
                                                        </td>
                                                    </tr>
                                                    <% }) %>
                                                        <% } else { %>
                                                            <tr>
                                                                <td colspan="4" class="text-center text-muted">No FAQs
                                                                    found.</td>
                                                            </tr>
                                                            <% } %>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>

                </div>
            </div>
        </div>

        <!-- Delete Modal -->
        <div class="modal fade" id="removeModal" tabindex="-1" aria-labelledby="removeModalLabel" aria-hidden="true">
            <div class="modal-dialog modal-sm modal-dialog-centered">
                <div class="modal-content">
                    <div class="modal-body text-center dlnotr">
                        <svg width="56" height="56" viewBox="0 0 56 56" fill="none">
                            <path
                                d="M5.6 16.8H50.4V53.2C50.4 53.94 50.1 54.65 49.58 55.18C49.05 55.7 48.34 56 47.6 56H8.4C7.66 56 6.94 55.7 6.42 55.18C5.89 54.65 5.6 53.94 5.6 53.2V16.8ZM11.2 22.4V50.4H44.8V22.4H11.2Z"
                                fill="#FF3C3C" />
                        </svg>
                        <h5 class="mt-3">Delete FAQ?</h5>
                        <p class="text-muted">Are you sure you want to delete this FAQ?</p>
                        <div class="d-flex justify-content-center">
                            <button type="button" class="btn btn-primary py-2 me-2"
                                data-bs-dismiss="modal">Cancel</button>
                            <button type="button" class="btn btn-danger py-2" id="confirmDelete">Yes</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>


        <!-- Add FAQ -->
        <div class="offcanvas offcanvas-end" tabindex="-1" id="add-user">
            <div class="offcanvas-header d-block">
                <div class="d-flex align-items-center">
                    <h5 class="offcanvas-title mb-0 me-3 fw-medium">Add FAQ</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="offcanvas"></button>
                </div>
            </div>
            <div class="offcanvas-body">
                <div class="mb-3">
                    <label class="fw-medium mb-1">Question</label>
                    <input type="text" id="addQuestion" class="form-control" placeholder="Enter Question">
                </div>
                <div class="mb-3">
                    <label class="fw-medium mb-1">Answer</label>
                    <input type="text" id="addAnswer" class="form-control" placeholder="Enter Answer">
                </div>
                <div class="text-end">
                    <button class="btn btn-outline-primary px-4 me-2" data-bs-dismiss="offcanvas">Cancel</button>
                    <button class="btn btn-primary px-4" id="saveFaq">Add</button>
                </div>
            </div>
        </div>

        <!-- Edit FAQ -->
        <div class="offcanvas offcanvas-end" tabindex="-1" id="tbl-edit">
            <div class="offcanvas-header d-block">
                <div class="d-flex align-items-center">
                    <h5 class="offcanvas-title mb-0 me-3 fw-medium">Edit FAQ</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="offcanvas"></button>
                </div>
            </div>
            <div class="offcanvas-body">
                <input type="hidden" id="editId">
                <div class="mb-3">
                    <label class="fw-medium mb-1">Question</label>
                    <input type="text" id="editQuestion" class="form-control">
                </div>
                <div class="mb-3">
                    <label class="fw-medium mb-1">Answer</label>
                    <input type="text" id="editAnswer" class="form-control">
                </div>
                <div class="text-end">
                    <button class="btn btn-outline-primary px-4 me-2" data-bs-dismiss="offcanvas">Cancel</button>
                    <button class="btn btn-primary px-4" id="updateFaq">Update</button>
                </div>
            </div>
        </div>

        <!-- View FAQ -->
        <div class="offcanvas offcanvas-end rdetails" tabindex="-1" id="view-details">
            <div class="offcanvas-header d-block">
                <div class="d-flex align-items-center">
                    <h5 class="offcanvas-title mb-0 me-3 fw-semibold">FAQ Details</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="offcanvas"></button>
                </div>
            </div>
            <div class="offcanvas-body">
                <div class="mb-3">
                    <label class="fw-medium mb-1">Question</label>
                    <input type="text" id="viewQuestion" class="form-control" readonly>
                </div>
                <div class="mb-3">
                    <label class="fw-medium mb-1">Answer</label>
                    <input type="text" id="viewAnswer" class="form-control" readonly>
                </div>
            </div>
        </div>

        <%- include("../common/footer.ejs") %>

            <script>
                let deleteId = null;

                // Add FAQ
                $("#saveFaq").click(function () {
                    const question = $("#addQuestion").val().trim();
                    const answer = $("#addAnswer").val().trim();

                    $.ajax({
                        url: "/createfaqs",
                        method: "POST",
                        data: { question, answer },
                        success: function (res) {
                            if (res.success) location.reload();
                        },
                    });
                });

                // Open Edit Form
                $(".editBtn").click(function () {
                    const row = $(this).closest("tr");
                    $("#editId").val($(this).data("id"));
                    $("#editQuestion").val(row.find("td:eq(1)").text());
                    $("#editAnswer").val(row.find("td:eq(2)").text());
                });

                // Update FAQ
                $("#updateFaq").click(function () {
                    const id = $("#editId").val();
                    const question = $("#editQuestion").val().trim();
                    const answer = $("#editAnswer").val().trim();
                    $.ajax({
                        url: "/faqsUpdate",
                        method: "POST",
                        data: { id, question, answer },
                        success: function () {
                            location.reload();
                        },
                     
                    });
                });

                // View FAQ
                $(".viewBtn").click(function () {
                    const row = $(this).closest("tr");
                    $("#viewQuestion").val(row.find("td:eq(1)").text());
                    $("#viewAnswer").val(row.find("td:eq(2)").text());
                });

                // Delete FAQ

                $(".deleteBtn").click(function () {
                    deleteId = $(this).data("id");
                });

                $("#confirmDelete").click(function () {
                    if (!deleteId) return;
                    $.ajax({
                        url: `/faqsdelete/${deleteId}`,
                        method: "POST",
                        success: function (res) {
                            if (res.success) {
                                $("#removeModal").modal("hide");
                                location.reload();
                            } else {
                                alert(res.message);
                            }
                        },
                      
                    });
                });

            </script>