<!doctype html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <title>Carim</title>
    <meta http-equiv="x-ua-compatible" content="ie=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1">
    <meta content="Dashboard | NextRoom8" name="description" />
    <!-- App favicon -->
    <link rel="shortcut icon" href="assets/images/logo.png">
    <!-- Select2 -->
    <link href="assets/libs/select2/select2.min.css" rel="stylesheet" type="text/css">
    <!-- JSvectormap Css -->
    <link href="assets/libs/jsvectormap/jsvectormap.min.css" rel="stylesheet" type="text/css" />
    <!-- metisMenu Css -->
    <link href="assets/libs/metismenu/metisMenu.min.css" rel="stylesheet" type="text/css" />
    <!-- metisMenu Css -->
    <link href="assets/libs/simplebar/simplebar.min.css" rel="stylesheet" type="text/css" />
    <!-- Bootstrap Css -->
    <link href="assets/libs/bootstrap/css/bootstrap.min.css" rel="stylesheet" type="text/css" />
    <!-- Icons Css -->
    <link href="assets/css/icons.css" rel="stylesheet" type="text/css" />
    <!-- App Css-->
    <link href="assets/css/app.css" id="app-style" rel="stylesheet" type="text/css" />
</head>

<body class="sidebar-enable">

    <style>
        .modal-backdrop~.modal-backdrop {
            z-index: 1050 !important
        }
    </style>

    <!-- Preloader -->
    <div class="preload">
        <div class="preloader-dots">
            <div class="dots"></div>
            <div class="dots"></div>
            <div class="dots"></div>
        </div>
    </div>

    <!-- Begin page -->
    <div id="layout-wrapper">

        <header id="page-topbar">
            <div class="navbar-header">
                <div class="d-flex align-items-center">
                    <div class="d-flex align-items-center" id="nav-first">
                        <button type="button" class="btn btn-sm vertical-menu-btn">
                            <i class="fe-menu"></i>
                        </button>
                        <a  class="new-logo"><img src="assets/images/logo.png"></a>
                    </div>

                    <!-- App Search-->
                    <!-- <form class="app-search d-none d-lg-block ms-3">
                            <div class="position-relative">
                                <input type="text" class="form-control" placeholder="Search name, phone number, email, ticket number...">
                                <span class="fas fa-search"></span>
                            </div>
                        </form> -->
                </div>

                <div class="d-flex align-items-center">



                    <!-- Profile -->
                    <div class="dropdown d-inline-block">
                        <button type="button" class="btn header-item waves-effect d-flex align-items-center"
                            id="page-header-user-dropdown" data-bs-toggle="dropdown" aria-haspopup="true"
                            aria-expanded="false">
                            <img class="header-profile-user" src="<%= session?.image %>" alt="Header Avatar">

                            <div class="text-start d-none d-xl-inline-block ms-2 me-2">
                                <span class="fw-medium font-size-15 nsuser">
                                    <%= session?.name %> <i class="uil-angle-down namearr"></i>
                                </span>
                            </div>
                        </button>
                        <div class="dropdown-menu pt-3 pb-2 dropdown-menu-end dropdown-profile">
                            <div class="innerdrop">
                                <div class="px-3 pb-1">
                                    <div class="font-size-14 text-muted mb-2"><span
                                            class="fw-medium me-1">Welcome</span> <small
                                            class="font-size-13">(Admin)</small></div>
                                    <div class="d-flex align-items-center">
                                        <img src="<%= session?.image %>" width="70" height="70"
                                            style="border-radius: 100px">
                                        <div class="ms-3">
                                            <div class="fw-semibold usprname" style="line-height: 1.3;"
                                                value="<%- session?.name %>">
                                                <%= session?.name %>
                                            </div>
                                            <div class="text-lowdark pb-1 usprmail" value="<%- session?.email %>">
                                                <%= session?.email %>
                                            </div>
                                            <a href="/editProfile">Edit Profile</a>
                                        </div>
                                    </div>
                                </div>
                                <div class="dropplink font-size-15 mt-2">
                                    <a href="/" class="d-block text-danger ps-3 pt-2"
                                        style="border-top: 1px solid #e9ecf0"><i
                                            class="ri-shut-down-line align-middle me-1 font-size-17"></i> <span
                                            class="font-size-15"  onclick="logout()">Logout</span></a>
                                </div>
                            </div>
                        </div>
                    </div>

                </div>
            </div>
        </header>