<%- include("../common/header.ejs") %>
    <%- include("../common/sidebar.ejs") %>

        <div class="main-content">
            <div class="page-content">
                <div class="container-fluid">

                    <div class="title-box mb-3 pb-1">
                        <h4 class="mb-0 page-title">ContactUs Listing</h4>
                        <nav aria-label="breadcrumb" class="mt-1">
                            <ol class="breadcrumb mb-0">
                                <li class="breadcrumb-item">
                                    <a href="/dashboard"><i class="ri-home-4-fill me-1"></i>Dashboard</a>
                                </li>
                                <li class="breadcrumb-item active" aria-current="page">ContactUs Listing</li>
                            </ol>
                        </nav>
                    </div>

                    <div class="card">
                        <div class="card-body cusbar">
                            <div class="table-responsive table-card border-top">
                                <table class="table table-centered align-middle mb-0">
                                    <thead>
                                        <tr>
                                            <th>Sr No</th>
                                            <th>Name</th>
                                            <th>Email</th>
                                            <th>Phone</th>
                                            <th>Message</th>
                                            <th>Action</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <% if (contactUsData && contactUsData.length> 0) { %>
                                            <% contactUsData.forEach((item, index)=> { %>
                                                <tr data-id="<%= item.id %>">
                                                    <td>
                                                        <%= index + 1 %>
                                                    </td>
                                                    <td>
                                                        <%= item.name %>
                                                    </td>
                                                    <td>
                                                        <%= item.email %>
                                                    </td>
                                                    <td>+<%= item.countryCode %>
                                                            <%= item.phone %>
                                                    </td>
                                                    <td>
                                                        <%= item.message.length> 40 ? item.message.substring(0, 40) +
                                                            '...' : item.message %>
                                                    </td>
                                                    <td class="text-center">
                                                        <div class="d-flex justify-content-center">
                                                            <button type="button"
                                                                class="btn btn-soft-primary px-2 btn-sm me-1 view-btn"
                                                                data-name="<%= item.name %>"
                                                                data-email="<%= item.email %>"
                                                                data-phone="+<%= item.countryCode %> <%= item.phone %>"
                                                                data-message="<%= item.message %>"
                                                                data-bs-toggle="offcanvas"
                                                                data-bs-target="#view-details">
                                                                <i class="ri-eye-fill font-size-16"></i>
                                                            </button>

                                                            <button type="button"
                                                                class="btn btn-soft-danger px-2 btn-sm deleteBtn"
                                                                data-bs-toggle="modal" data-bs-target="#removeModal"
                                                                data-id="<%= item.id %>">
                                                                <i class="ri-delete-bin-line font-size-16"></i>
                                                            </button>
                                                        </div>
                                                    </td>
                                                </tr>
                                                <% }) %>
                                                    <% } else { %>
                                                        <tr>
                                                            <td colspan="6" class="text-center text-muted">No contact
                                                                entries found</td>
                                                        </tr>
                                                        <% } %>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>

                </div>
            </div>
        </div>

        <!-- Offcanvas View -->
        <div class="offcanvas offcanvas-end" tabindex="-1" id="view-details">
            <div class="offcanvas-header">
                <h5 class="offcanvas-title">Contact Details</h5>
                <button type="button" class="btn-close" data-bs-dismiss="offcanvas"></button>
            </div>
            <div class="offcanvas-body">
                <table class="table table-borderless">
                    <tr>
                        <td>Name:</td>
                        <td id="vName" class="text-end"></td>
                    </tr>
                    <tr>
                        <td>Email:</td>
                        <td id="vEmail" class="text-end"></td>
                    </tr>
                    <tr>
                        <td>Phone:</td>
                        <td id="vPhone" class="text-end"></td>
                    </tr>
                </table>
                <hr>
                <div class="fw-bold">Message</div>
                <p id="vMessage"></p>
            </div>
        </div>

        <!-- Delete Confirmation Modal -->
        <div class="modal fade" id="removeModal" tabindex="-1" aria-labelledby="removeModalLabel" aria-hidden="true">
            <div class="modal-dialog modal-sm modal-dialog-centered">
                <div class="modal-content">
                    <div class="modal-body text-center dlnotr">
                        <svg width="56" height="56" viewBox="0 0 56 56" fill="none">
                            <path
                                d="M5.6 16.8H50.4V53.2C50.4 53.94 50.1 54.65 49.58 55.18C49.05 55.7 48.34 56 47.6 56H8.4C7.66 56 6.94 55.7 6.42 55.18C5.89 54.65 5.6 53.94 5.6 53.2V16.8ZM11.2 22.4V50.4H44.8V22.4H11.2Z"
                                fill="#FF3C3C" />
                        </svg>
                        <h5 class="mt-3">Delete ContactUs?</h5>
                        <p class="text-muted">Are you sure you want to delete this contactus?</p>
                        <div class="d-flex justify-content-center">
                            <button type="button" class="btn btn-primary py-2 me-2"
                                data-bs-dismiss="modal">Cancel</button>
                            <button type="button" class="btn btn-danger py-2" id="confirmDelete">Yes</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <%- include("../common/footer.ejs") %>

            <script>
                let deleteId = null;

                $(".view-btn").click(function () {
                    $("#vName").text($(this).data("name"));
                    $("#vEmail").text($(this).data("email"));
                    $("#vPhone").text($(this).data("phone"));
                    $("#vMessage").text($(this).data("message"));
                });

                $(".deleteBtn").click(function () {
                    deleteId = $(this).data("id");
                });

                $("#confirmDelete").click(function () {
                    if (!deleteId) return;
                    $.ajax({
                        url: `/deleteContact/${deleteId}`,
                        method: "POST",
                        success: function (res) {
                            if (res.success) {
                                $("#removeModal").modal("hide");
                                location.reload();
                            } else {
                                alert(res.message);
                            }
                        },

                    });
                });
            </script>