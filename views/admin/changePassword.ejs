            <script src="https://code.jquery.com/jquery-3.6.4.min.js"></script>
            <script src="https://cdn.jsdelivr.net/npm/jquery-validation@1.19.5/dist/jquery.validate.min.js"></script>

            <script>
                $(function () {


                    const debugInvalidHandler = function (event, validator) {
                        console.log("Validation failed, invalid elements:", validator.invalid);
                    };

                    $.validator.addMethod("notEqualToOld", function (value, element) {
                        const old = $("#oldPassword").val() || '';
                        return this.optional(element) || value !== old;
                    }, "Old password can't be your new password.");

                    $('#cpForm').validate({
                        errorElement: 'div',
                        errorClass: 'invalid-feedback d-block',
                        errorPlacement: function (error, element) {
                            try {
                                const id = element.attr('id');
                                const target = $("#" + id + "-error");
                                if (target.length) {
                                    error.appendTo(target);
                                } else {
                                    error.insertAfter(element);
                                }
                            } catch (e) {
                                console.error("errorPlacement exception:", e);
                                error.insertAfter(element);
                            }
                        },
                        rules: {
                            oldPassword: { required: true },
                            newPassword: { required: true, minlength: 5, notEqualToOld: true },
                            confirmPassword: { required: true, equalTo: "#newPassword" }
                        },
                        messages: {
                            oldPassword: { required: "Please enter your current password" },
                            newPassword: {
                                required: "Please enter your new password",
                                minlength: "Password must be at least 5 characters long",
                                notEqualToOld: "Old password can't be your new password"
                            },
                            confirmPassword: {
                                required: "Please confirm your new password",
                                equalTo: "Passwords do not match"
                            }
                        },
                        invalidHandler: debugInvalidHandler,
                        submitHandler: function (form) {
                            console.log("Form validated — submitting.");
                            form.submit();
                        }
                    });

                    $('#oldPassword, #newPassword, #confirmPassword').on('keyup blur', function () {
                        $(this).valid();
                    });

                    $('#cpForm').on('submit', function (e) {
                    });
                });
            </script>